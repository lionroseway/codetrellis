{
  "expo": {
    "name": "CodeTrellis Companion",
    "slug": "codetrellis",
    "version": "0.1.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "codetrellis",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.codetrellis.mobile",
      "infoPlist": {
        "CFBundleDisplayName": "CodeTrellis",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CodeTrellis uses the camera to scan QR codes for pairing with your desktop.",
        "NSLocalNetworkUsageDescription": "CodeTrellis needs local network access to pair with your desktop and sync workspace data.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "dev.codetrellis.mobile",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CodeTrellis uses the camera to scan QR codes for pairing with your desktop."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "@config-plugins/react-native-webrtc",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47be6d4e-2e16-47a9-958d-afb4ebaab412"
      }
    },
    "owner": "ailar"
  }
}
