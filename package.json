{
  "name": "codetrellis",
  "productName": "CodeTrellis",
  "version": "0.1.0",
  "description": "Monitor AI coding agents and visualize their impact on codebase architecture in real-time",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite --config vite.web.config.ts",
    "dev:backend": "tsx watch src/backend/index.ts",
    "start:electron": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "tsc --noEmit && vite build --config vite.web.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "tailwindcss": "^4.0.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@xyflow/react": "^12.0.0",
    "allotment": "^1.20.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "express": "^5.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^2.6.0",
    "web-tree-sitter": "^0.26.8",
    "ws": "^8.18.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  }
}
