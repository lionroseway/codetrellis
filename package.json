{
  "name": "codetrellis",
  "productName": "CodeTrellis",
  "version": "0.1.2",
  "description": "Monitor AI coding agents and visualize their impact on codebase architecture in real-time",
  "license": "Apache-2.0",
  "homepage": "https://codetrellis.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lionroseway/codetrellis-releases"
  },
  "main": "out/main/main.js",
  "scripts": {
    "predev": "bash scripts/free-dev-ports.sh",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "predev:frontend": "bash scripts/free-dev-ports.sh 5173",
    "dev:frontend": "vite --config vite.web.config.ts",
    "predev:backend": "bash scripts/free-dev-ports.sh 19432 3001",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:electron": "electron-vite dev",
    "prepackage": "node scripts/build-icons.js && node scripts/generate-build-info.js",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac --arm64",
    "package:mac-x64": "electron-vite build && electron-builder --mac --x64",
    "package:mac-universal": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win --x64",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:all": "electron-vite build && electron-builder --mac --arm64 --win --x64 --linux",
    "release": "bash scripts/release.sh",
    "release:dry-run": "bash scripts/release.sh --dry-run",
    "build:icons": "node scripts/build-icons.js",
    "build:info": "node scripts/generate-build-info.js",
    "build": "tsc --noEmit && vite build --config vite.web.config.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:harness": "playwright test --config=playwright.harness.config.ts",
    "test:harness:headed": "playwright test --config=playwright.harness.config.ts --headed",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "png2icons": "^2.0.1",
    "tailwindcss": "^4.0.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@types/d3-force": "^3.0.10",
    "@xyflow/react": "^12.0.0",
    "allotment": "^1.20.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3-force": "^3.0.0",
    "express": "^5.0.0",
    "html-to-image": "^1.11.13",
    "ignore": "^7.0.5",
    "lucide-react": "^0.460.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^2.6.0",
    "web-tree-sitter": "^0.26.8",
    "ws": "^8.18.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "dev.codetrellis.app",
    "productName": "CodeTrellis",
    "copyright": "Copyright © 2026 CodeTrellis Contributors",
    "directories": {
      "output": "out/make",
      "buildResources": "resources"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tree-sitter",
        "to": "tree-sitter",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/sql.js",
        "to": "sql.js",
        "filter": ["package.json", "dist/sql-wasm.js", "dist/sql-wasm.wasm"]
      },
      {
        "from": "node_modules/web-tree-sitter",
        "to": "web-tree-sitter",
        "filter": ["package.json", "web-tree-sitter.cjs", "web-tree-sitter.wasm"]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false,
      "title": "${productName} ${version}",
      "icon": "resources/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        { "x": 130, "y": 180, "type": "file" },
        { "x": 410, "y": 180, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeTrellis"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": ["deb", "rpm", "AppImage"],
      "icon": "resources/icon.png",
      "category": "Development",
      "maintainer": "CodeTrellis Contributors",
      "vendor": "CodeTrellis",
      "synopsis": "Monitor AI coding agents and visualize codebase architecture",
      "description": "CodeTrellis monitors AI coding agents (starting with Claude Code) and visualizes their impact on codebase architecture in real-time."
    }
  }
}
