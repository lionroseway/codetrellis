{
  "name": "codetrellis",
  "productName": "CodeTrellis",
  "version": "0.1.15",
  "description": "Monitor AI coding agents and visualize their impact on codebase architecture in real-time",
  "license": "Apache-2.0",
  "homepage": "https://codetrellis.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lionroseway/codetrellis-releases"
  },
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "patch-package",
    "predev": "bash scripts/free-dev-ports.sh && npm run build:connector && npm run build:rendition && npm run build:reader",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "predev:frontend": "bash scripts/free-dev-ports.sh 5173",
    "dev:frontend": "vite --config vite.web.config.ts",
    "predev:backend": "bash scripts/free-dev-ports.sh 19432 3001",
    "dev:backend": "tsx watch --watch-path=src/backend --watch-path=src/shared src/backend/index.ts",
    "predev:electron": "npm run build:connector && npm run build:rendition && npm run build:reader",
    "dev:electron": "electron-vite dev",
    "check:bundle": "bash scripts/check-no-relative-require.sh",
    "prepackage": "node scripts/build-icons.js",
    "package": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && electron-builder",
    "package:mac": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && electron-builder --mac --arm64",
    "package:mac-x64": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && electron-builder --mac --x64",
    "package:mac-universal": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && electron-builder --mac",
    "package:mac:signed": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && CT_SIGN=1 electron-builder --mac --config electron-builder.signed.cjs",
    "package:win": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && electron-builder --win --x64",
    "package:linux": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && electron-builder --linux",
    "package:all": "npm run check:bundle && electron-vite build && npm run build:connector && npm run build:rendition && npm run build:reader && npm run fetch:rendition-engine && electron-builder --mac --arm64 --win --x64 --linux",
    "release": "bash scripts/release.sh",
    "release:dry-run": "bash scripts/release.sh --dry-run",
    "build:icons": "node scripts/build-icons.js",
    "build:connector": "vite build --config vite.connector.config.ts",
    "build:rendition": "vite build --config vite.rendition.config.ts",
    "build:reader": "vite build --config vite.reader.config.ts",
    "fetch:rendition-engine": "node scripts/fetch-rendition-engine.mjs",
    "build": "tsc --noEmit && vite build --config vite.web.config.ts",
    "test": "playwright test",
    "test:unit": "node --import tsx --test 'src/**/*.test.ts'",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:harness": "playwright test --config=playwright.harness.config.ts",
    "test:harness:headed": "playwright test --config=playwright.harness.config.ts --headed",
    "capture": "playwright test --config=playwright.marketing.config.ts",
    "capture:screenshots": "playwright test --config=playwright.marketing.config.ts screenshots",
    "capture:videos": "playwright test --config=playwright.marketing.config.ts videos",
    "smoke:plan-items": "tsx scripts/smoke-plan-items.ts",
    "smoke:plan-migrate": "tsx scripts/smoke-plan-migrate.ts",
    "smoke:schema-reconcile": "tsx scripts/smoke-schema-reconcile.ts",
    "demo": "tsx scripts/demo.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "patch-package": "^8.0.1",
    "png2icons": "^2.0.1",
    "tailwindcss": "^4.0.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@types/d3-force": "^3.0.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.0.0",
    "allotment": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "express": "^5.0.0",
    "fast-json-patch": "^3.1.1",
    "html-to-image": "^1.11.13",
    "ignore": "^7.0.5",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.3",
    "node-pty": "^1.2.0-beta.13",
    "pdfjs-dist": "^6.3.289",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^2.6.0",
    "web-tree-sitter": "^0.27.0",
    "werift": "^0.24.4",
    "ws": "^8.18.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "dev.codetrellis.app",
    "productName": "CodeTrellis",
    "copyright": "Copyright \u00a9 2026 CodeTrellis Contributors",
    "directories": {
      "output": "out/make",
      "buildResources": "resources"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json",
      "!**/node_modules/pdfjs-dist/**",
      "!**/node_modules/@napi-rs/canvas*/**"
    ],
    "extraResources": [
      {
        "from": "out/connector",
        "to": "connector",
        "filter": [
          "mcp-connector.cjs"
        ]
      },
      {
        "from": "out/rendition",
        "to": "rendition",
        "filter": [
          "engine-child.cjs"
        ]
      },
      {
        "from": "out/reader",
        "to": "reader",
        "filter": [
          "material-reader.mjs"
        ]
      },
      {
        "from": "resources/rendition/engine",
        "to": "rendition/engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/spellcheck",
        "to": "spellcheck",
        "filter": [
          "*.bdic",
          "COPYING*",
          "LICENSE"
        ]
      },
      {
        "from": "resources/tree-sitter",
        "to": "tree-sitter",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/sql.js",
        "to": "sql.js",
        "filter": [
          "package.json",
          "dist/sql-wasm.js",
          "dist/sql-wasm.wasm"
        ]
      },
      {
        "from": "node_modules/web-tree-sitter",
        "to": "web-tree-sitter",
        "filter": [
          "package.json",
          "web-tree-sitter.cjs",
          "web-tree-sitter.wasm"
        ]
      }
    ],
    "asar": true,
    "afterPack": "./scripts/adhoc-sign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false,
      "title": "${productName} ${version}",
      "icon": "resources/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 180,
          "type": "file"
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeTrellis"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "maintainer": "CodeTrellis Contributors",
      "vendor": "CodeTrellis",
      "synopsis": "Monitor AI coding agents and visualize codebase architecture",
      "description": "CodeTrellis monitors AI coding agents (starting with Claude Code) and visualizes their impact on codebase architecture in real-time."
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
