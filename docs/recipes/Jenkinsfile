// CodeTrellis in Jenkins (Phase 33 C2): a stage for your Jenkinsfile.
// check.sh does the work; the Warnings NG plugin reads the SARIF.
pipeline {
  agent { docker { image 'node:26' } }
  stages {
    stage('CodeTrellis conformity') {
      when { changeRequest() }
      steps {
        sh 'git fetch --quiet origin "$CHANGE_TARGET"'
        sh 'CODETRELLIS_JUNIT=test-results/junit.xml sh docs/recipes/check.sh'
      }
      post {
        always {
          archiveArtifacts artifacts: 'codetrellis.sarif', allowEmptyArchive: true
          recordIssues tool: sarif(pattern: 'codetrellis.sarif')
        }
      }
    }
  }
}
